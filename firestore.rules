// Firestore security rules for technoteacher.org
//
// HOW TO USE: the "Publish Firestore rules on merge" workflow on GitHub
// publishes this file when it changes on main (once its one-time setup is
// done). To publish by hand instead, copy everything in this file, then in the
// Firebase console go to Firestore Database -> Rules, select all, paste, and
// press Publish.
//
// WHEN: the order of publishing does not matter. The pages go live by
// themselves when they are merged; these rules go live when they are published.
//  - New rules, old pages: every page keeps working exactly as before.
//  - New pages, old rules: the Classes page works as before for you, and its
//    "Teachers" panel shows a yellow note asking you to publish the new rules.
//    Nobody else can be added as a teacher until you do.
//
// NEVER GO BACK to an older version of these rules (the console's revert
// button, or pasting an older copy of this file) once the Classes page has
// moved the join codes into "joinCodes": students could not join a class, and
// the codes would show as "hidden", until these rules are published again.
//
// THE PEOPLE
//  - The OWNER is ncapellini@hhh.k12.ny.us (written into isOwner() below). The
//    owner keeps every power he has always had over the whole site: all altitude
//    results, the settings, the races, the Sail Car Lab progress and runs, and
//    the Rocket Lab builds.
//  - A TEACHER is anyone the owner has added on the Classes page ("Teachers"
//    panel). That adds a small document to the "teachers" list, named with the
//    teacher's lowercase school email. Removing the teacher deletes it; their
//    classes stay in the database but they lose access to them.
//  - A STUDENT is every other signed-in school account.
//  - Only verified Google accounts @hhh.k12.ny.us can read or write anything.
//
// WHAT A TEACHER CAN DO (the owner is a teacher too)
//  - Make classes, give them join codes, see the roster and remove students,
//    for their OWN classes only. A teacher cannot read, change or delete
//    another teacher's classes, join codes or rosters. That includes the owner:
//    his Classes page shows and manages his own classes only.
//  - Read the altitude results and the Sail Car Lab runs that were saved for
//    one of their own classes, and delete a Sail Car Lab run of their own class.
//  - Read the Sail Car Lab progress of a student who is in one of their own
//    classes (one student at a time; the student's progress lists the classes
//    they are in, and each must be a class they really joined).
//  - A teacher who is not the owner has none of the owner's site-wide powers:
//    they cannot read everyone's results or progress, change the settings or
//    the races, or change or delete a result, or change a run.
//  - A teacher can update only three fields of their own "teachers" entry: when
//    they were last here and how many classes and students they have. The
//    Classes page does that so the owner can see who is using the site.
//
// WHAT A STUDENT CAN DO
//  - Altitude Calculator results ("results"): read only their own results and
//    the results of a class they have joined; save their own.
//  - Look up the one join code they type (nobody can list the codes except a
//    teacher, and only their own), and join a class with it. Class names are
//    readable by every signed-in account, because the game pages list them, but
//    a class no longer carries its code.
//  - A class the Classes page has not moved over yet keeps working with the
//    code still stored on it, so the order of publishing does not matter.
//  - A student's altitude above the teacher's limit (Launch-Day Setup, 300 ft
//    by default) is saved as "waiting for teacher check" and stays off the boards.
//  - "settings/altitude-top20" is the public Top 20 board every signed-in
//    student may read. "settings/altitude-rankings" (the lock) is owner-only.
//  - rocket_builds: each student's "I'm building this one" design from Rocket Lab.
//  - Sail Car Lab: sailcar_progress (each student's modules and Design Studio
//    design; the student and the owner can read it, and the teacher of a class
//    the student is in; only the student and the owner can save it) and
//    sailcar_runs (real hallway runs, private to the class like the altitude
//    boards). A student can save only their own progress and runs, only in the
//    shape the lab saves them and under their own Google name.
//  - Tech Bucks: a student reads their own ledger (techbucks) and can earn only
//    the fixed awards listed there, each at most once (see the Tech Bucks block below).
//    They can spend them in the Avatar Shop (stage B) and show an avatar (avatars/{uid}).
//  - Everything else behaves as before.
//
// TECH BUCKS: every award is its own document, techbucks/{uid}_{key}. The ledger is the
// truth: a student's balance is the sum of their ledger documents (earnings are positive,
// purchases are negative). A student can create an award only if its key is on the list
// in amountFor() below, its amount is the fixed amount for that key, and no award with
// that key exists yet; they can never delete one. Awards that can repeat carry today's date
// (UTC, taken from the server's clock) and a slot number, which caps them per day. A teacher
// can give a bonus of 1 to 50 to a student in one of their own classes, and can read and
// remove the awards that carry one of their own classes.
//
// STAGE B (the Avatar Shop). Rules cannot add up a ledger, so spending needs a running
// total: techbucks_totals/{uid} = {uid, earned, spent, last, updatedAt}; the balance is
// earned - spent. Nobody can write earned or spent freely. A totals document changes ONLY
// in the same batch as one matching ledger change, and "last" names that ledger document:
//   - a student's earn (counted: true)  -> earned goes up by exactly its amount
//   - a teacher's bonus (counted: true) -> earned goes up by exactly its amount
//   - a purchase  techbucks/{uid}_buy_{itemId}  (kind "spend", amount = -priceFor(itemId),
//     one per item)                     -> spent goes up by exactly the price, and
//                                          earned - spent stays at 0 or more
//   - a teacher removing a counted award -> earned goes down by exactly its amount (the
//     balance may drop below zero; buying is blocked until it is back above the price)
//   - "counted" marks an award the totals already include. Awards made before totals existed
//     (and awards from an old page, which are created without the mark) are counted later by
//     their student: counted flips from missing to true, once, in the same batch as earned
//     going up by exactly that award's amount.
//   - A totals document may also be created as {earned: 0, spent: 0}, never with other numbers.
// "last" is the one addition to the plan: without it a totals rule cannot know which ledger
// document it is coupled to. The ledger side also requires that the totals document was
// written in the same request (updatedAt == request.time), so an old coupling cannot be reused.
// A purchase can never be deleted or changed, by anyone. A teacher can read the purchases of
// their classes (they carry the class, like awards) but not remove them.
// AVATARS: avatars/{uid} = {uid, equipped: {slot: itemId}, updatedAt}. A student writes only
// their own, only the eleven known slots (skin, face, hair, haircolor, hat, gear, pet, back, bg,
// outfit, fx), and only items that are free (price 0) or that they
// own (their purchase document exists, or is created in the same batch). Any signed-in school
// account can read them (cosmetic only: presets, no text, no personal data).
// priceFor() below is the single price list; avatar.js carries a copy and a test fails if
// they ever differ.
// New rules, old pages: nothing changes for anyone (an old page's award has no "counted"
// mark and is accepted as before; it is counted the next time its student opens a new page).
// New pages, old rules: awards are written exactly as before (ledger only), the shop shows
// "opens soon". What a determined student could still claim is listed above amountFor().
//
// JOIN CODES: each code is kept in "joinCodes/{CODE}" with its class and its
// teacher. "New code" on the Classes page replaces a class's code (new codes
// have 8 characters, which makes guessing one hopeless; older 6-character codes
// keep working until they are replaced).

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in with a verified school Google account. (The site already turns
    // everyone else away; this makes the database refuse them too.)
    function signedIn() {
      return request.auth != null
             && request.auth.token.email_verified == true
             && request.auth.token.firebase.sign_in_provider == 'google.com'
             && request.auth.token.email.matches('^.+@hhh[.]k12[.]ny[.]us$');
    }
    // The site owner. Written here on purpose: it needs no database lookup, so
    // the owner can never be locked out.
    function isOwner() {
      return signedIn() && request.auth.token.email == 'ncapellini@hhh.k12.ny.us';
    }
    // The owner, or a teacher the owner has added (teachers/{lowercase email}).
    function isTeacher() {
      return signedIn()
             && (isOwner()
                 || exists(/databases/$(database)/documents/teachers/$(request.auth.token.email.lower())));
    }
    // The class exists and belongs to the signed-in teacher (the state before
    // this request's writes; a class deleted in the same batch is still seen).
    function ownsClass(classId) {
      return classId is string && classId != ''
             && get(/databases/$(database)/documents/classes/$(classId)).data.teacherEmail == request.auth.token.email;
    }
    // The same, but as the class will be once this batch or transaction commits
    // (for a join code written in the same batch as the class it points at).
    function ownsClassAfter(classId) {
      return classId is string && classId != ''
             && getAfter(/databases/$(database)/documents/classes/$(classId)).data.teacherEmail == request.auth.token.email;
    }
    // The signed-in account is the one named by this teachers/{email} id.
    function isThisTeacher(email) {
      return signedIn() && email == request.auth.token.email.lower();
    }
    // A school email address in lowercase, usable as a teachers/{email} id.
    function schoolEmailId(email) {
      return email.size() <= 100
             && email == email.lower()
             && email.matches('^[^@/]+@hhh[.]k12[.]ny[.]us$');
    }
    function validCount(n) {
      return n is number && n >= 0 && n <= 5000;
    }
    // A student may only add themselves to a class with that class's join code,
    // exactly as the Join form on classes.html does it. The code must be the
    // class's entry in joinCodes, or (for a class the Classes page has not moved
    // over yet) the code still stored on the class itself.
    function validJoin(id) {
      let d = request.resource.data;
      return d.uid == request.auth.uid
             && d.classId is string
             && id == d.classId + '_' + request.auth.uid
             && exists(/databases/$(database)/documents/classes/$(d.classId))
             && d.code is string
             && (joinCodeOpens(d) || classCodeOpens(d));
    }
    // joinCodes/{CODE} exists and points at this class.
    function joinCodeOpens(d) {
      return d.code.matches('^[A-Z0-9]{1,20}$')
             && exists(/databases/$(database)/documents/joinCodes/$(d.code))
             && get(/databases/$(database)/documents/joinCodes/$(d.code)).data.classId == d.classId;
    }
    // Not moved over yet: the class still has a non-empty 'code' equal to d.code.
    function classCodeOpens(d) {
      let c = get(/databases/$(database)/documents/classes/$(d.classId)).data.get('code', '');
      return c is string && c != '' && d.code == c;
    }
    // A teacher writing a roster entry (enrollments/{classId}_{uid}) for one of
    // their own classes. The id must start with that class's id: otherwise a
    // teacher could plant an entry that makes someone "in" another teacher's class.
    // Both halves of the id are plain letters and digits (as the pages make them): pages
    // put these ids into buttons, so a teacher cannot plant an id that carries code.
    function teacherRosterWrite(id) {
      let c = request.resource.data.classId;
      return isTeacher() && c is string && id.matches('^[A-Za-z0-9]+_[A-Za-z0-9]+$')
             && id.split('_')[0] == c && ownsClass(c);
    }
    // Highest believable altitude in feet, from the teacher's launch-day setup
    // (settings/altitude-setup); 300 ft until the teacher sets one.
    function maxFt() {
      let m = exists(/databases/$(database)/documents/settings/altitude-setup)
              ? get(/databases/$(database)/documents/settings/altitude-setup).data.get('maxFt', 300)
              : 300;
      return (m is number && m >= 10 && m <= 100000) ? m : 300;
    }
    function altitudeFt(d) {
      return d.unit == 'm' ? d.altitude * 3.28084 : d.altitude;
    }
    // True when the signed-in student has joined the class (classes.html
    // stores each enrollment at enrollments/{classId}_{uid}).
    function inClass(classId) {
      return exists(/databases/$(database)/documents/enrollments/$(classId + '_' + request.auth.uid));
    }

    // ── Teachers ────────────────────────────────────────────────────────────
    // teachers/{lowercase email} = {email, addedAt, addedBy, lastSeen,
    // classCount, studentCount}. Only the owner adds or removes teachers. A
    // teacher can read their own entry (the Classes page checks it to know to
    // show the teacher view) and update only lastSeen, classCount and studentCount.
    match /teachers/{email} {
      allow get: if isOwner() || isThisTeacher(email);
      allow list: if isOwner();
      allow create: if isOwner()
                    && schoolEmailId(email)
                    && request.resource.data.email == email;
      allow delete: if isOwner() && schoolEmailId(email);
      allow update: if isOwner()
                    || (isThisTeacher(email)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['lastSeen', 'classCount', 'studentCount'])
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSeen'])
                            || request.resource.data.lastSeen == request.time)
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['classCount'])
                            || validCount(request.resource.data.classCount))
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentCount'])
                            || validCount(request.resource.data.studentCount)));
    }

    // ── Rocket Altitude Calculator ──────────────────────────────────────────
    match /results/{id} {
      allow read: if isOwner()
                  || (signedIn() && resource.data.userEmail == request.auth.token.email)
                  || (signedIn() && inClass(resource.data.classId))
                  // a teacher reads the results saved for one of their own classes
                  || (isTeacher() && ownsClass(resource.data.classId));
      allow create: if isOwner()
                    || (signedIn()
                        && request.resource.data.userEmail == request.auth.token.email
                        && request.resource.data.name is string
                        && request.resource.data.name.size() <= 60
                        && request.resource.data.altitude is number
                        && request.resource.data.altitude > 0
                        && request.resource.data.unit in ['ft', 'm']
                        // above the limit it must wait for the teacher's check
                        && (request.resource.data.get('review', '') == 'pending'
                            || (!('review' in request.resource.data)
                                && altitudeFt(request.resource.data) <= maxFt()))
                        && (request.resource.data.get('classId', '') == ''
                            || inClass(request.resource.data.classId)));
      allow update, delete: if isOwner();
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isOwner()
                   || (signedIn()
                       && id == 'altitude-top20'
                       && request.resource.data.entries is list
                       && request.resource.data.entries.size() <= 20);
    }

    // ── Games and other leaderboards (unchanged) ────────────────────────────
    match /game-results/{id} {
      allow read, write: if signedIn();
    }
    match /sailcar_results/{id} {
      allow read, write: if signedIn();
    }
    match /rocket_results/{id} {
      allow read, write: if signedIn();
    }
    // ── Sail Car Lab ────────────────────────────────────────────────────────
    // A student's own progress doc, exactly as the lab saves it: the modules
    // (sailcar-core.js writes uid, name, email, updatedAt, modules) and the
    // Design Studio's design (sailcar-studio.js writes design + updatedAt).
    // Both save with "merge", and the rules check the whole document as it
    // will be after the merge, so each save must leave the whole doc valid.
    function validProgress(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'name', 'email', 'updatedAt', 'modules', 'design', 'classIds'])
             && d.get('uid', id) == id
             && d.get('name', '') is string && d.get('name', '').size() <= 100
             && d.get('email', '') is string && d.get('email', '').size() <= 100
             && d.get('modules', {}) is map && d.get('modules', {}).size() <= 12
             && d.get('design', {}) is map && d.get('design', {}).size() <= 40
             && validClassIds(id);
    }
    // classIds: the classes the student is in, kept by the lab from the student's
    // own enrollments so that the teacher of each class can read this progress
    // (see the read rule below). At most 4 plain class ids. When a save changes
    // the list, every id in it must be a class the student really joined (their
    // enrollment exists), so nobody can point their progress at a teacher whose
    // class they are not in. A list that a save leaves as it is (an older page
    // that does not know the field, or a class left since) is not checked again:
    // the read rule checks the enrollment at the moment of reading.
    function validClassIds(uid) {
      let n = request.resource.data.get('classIds', []);
      return n is list && n.size() <= 4
             && ((resource != null && resource.data.get('classIds', []) == n)
                 || (classIdJoined(n, 0, uid) && classIdJoined(n, 1, uid)
                     && classIdJoined(n, 2, uid) && classIdJoined(n, 3, uid)));
    }
    // Entry i of the list (if there is one) is a plain class id of a class this student joined.
    function classIdJoined(n, i, uid) {
      return n.size() <= i
             || (n[i] is string && n[i].matches('^[A-Za-z0-9]{1,40}$')
                 && exists(/databases/$(database)/documents/enrollments/$(n[i] + '_' + uid)));
    }
    // Teacher read of a progress doc: entry i of its classIds is a class the
    // signed-in teacher owns and the student is still enrolled in.
    function teachesClassIdAt(n, i, uid) {
      return n.size() > i
             && n[i] is string && n[i].matches('^[A-Za-z0-9]{1,40}$')
             && exists(/databases/$(database)/documents/classes/$(n[i]))
             && get(/databases/$(database)/documents/classes/$(n[i])).data.teacherEmail == request.auth.token.email
             && exists(/databases/$(database)/documents/enrollments/$(n[i] + '_' + uid));
    }
    function teachesProgress(uid) {
      let n = resource.data.get('classIds', []);
      return isTeacher() && n is list && n.size() <= 4
             && (teachesClassIdAt(n, 0, uid) || teachesClassIdAt(n, 1, uid)
                 || teachesClassIdAt(n, 2, uid) || teachesClassIdAt(n, 3, uid));
    }
    // A real hallway run, exactly as the Design Studio logs it: only these
    // fields, under the student's own account, stamped with the server's time.
    // The name on the board is the student's own Google name (the sign-in's
    // "name"; their email if the account has no name), so nobody can post a
    // run under a classmate's name.
    function validRun() {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'userEmail', 'name', 'classId', 'className', 'distanceM', 'unit',
                               'distance', 'predictedM', 'model', 'design', 'note', 'savedAt'])
             && d.keys().hasAll(['uid', 'userEmail', 'name', 'classId', 'distanceM', 'savedAt'])
             && d.uid == request.auth.uid
             && d.userEmail == request.auth.token.email
             && d.name is string && d.name.size() <= 100
             && d.name == request.auth.token.get('name', request.auth.token.email)
             && d.get('className', '') is string && d.get('className', '').size() <= 80
             && d.distanceM is number && d.distanceM >= 0 && d.distanceM <= 100
             && d.get('unit', 'm') in ['m', 'ft']
             && d.get('distance', 0) is number && d.get('distance', 0) >= 0
             && d.get('predictedM', 0) is number && d.get('predictedM', 0) >= 0 && d.get('predictedM', 0) <= 100
             && d.get('model', '') is string && d.get('model', '').size() <= 24
             && (!('design' in d)
                 || (d.design is map
                     && d.design.keys().hasOnly(['summary', 'grams'])
                     && d.design.summary is string && d.design.summary.size() <= 160
                     && d.design.grams is number))
             && d.get('note', '') is string && d.get('note', '').size() <= 80
             && d.savedAt == request.time
             && d.classId is string
             && (d.classId == '' || inClass(d.classId));
    }
    // Each student's module progress and design. Read by the student, by the
    // owner (everyone's), and by the teacher of a class the student is in (the
    // class is named in classIds; see validClassIds). A teacher reads these one
    // student at a time (get), never as a list.
    match /sailcar_progress/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid)
                  || (signedIn() && teachesProgress(uid));
      allow create, update: if isOwner()
                            || (signedIn() && request.auth.uid == uid && validProgress(uid));
      allow delete: if isOwner();
    }
    // Real hallway runs: visible to the student, their class, the owner, and
    // the teacher whose class the run was saved for. That teacher can also
    // delete a run of their class (a wrong or silly entry); only the owner can
    // change one.
    match /sailcar_runs/{id} {
      allow read: if isOwner()
                  || (signedIn() && resource.data.userEmail == request.auth.token.email)
                  || (signedIn() && inClass(resource.data.classId))
                  || (isTeacher() && ownsClass(resource.data.classId));
      allow create: if isOwner() || (signedIn() && validRun());
      allow update: if isOwner();
      allow delete: if isOwner() || (isTeacher() && ownsClass(resource.data.classId));
    }

    // Rocket Lab: the design a student says they are really building
    match /rocket_builds/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // ── Tech Bucks ──────────────────────────────────────────────────────────
    // techbucks/{uid}_{key}: one document per award, so an award can exist only
    // once per key. Fields: uid, key, amount, kind ("earn" | "bonus"; later "spend"
    // with a negative amount, which nobody can create yet), reason, createdAt (the
    // server's time), classId (optional: a class the student is in; a teacher reads and
    // removes the awards of their own classes), and for a bonus: by (the teacher's email).
    // The balance is always the sum of a student's amounts.
    //
    // What a student with developer tools could still do: claim any award on the list
    // below that has no proof, once (the first Sail Car run, the first Altitude launch,
    // and the day slots for runs and launches: at most 2 and 3 a day). Their own
    // progress and build records can also be written by hand, so those proofs only
    // make the student do the step in the database. The most a student can reach by hand
    // is the fixed total of the one-time awards plus the daily slots. A teacher sees every
    // award that carries one of their own classes and can remove it.
    function pad2(n) {
      return (n < 10 ? '0' : '') + string(n);
    }
    // a date (UTC) as YYYYMMDD
    function ymd(t) {
      return string(t.year()) + pad2(t.month()) + pad2(t.day());
    }
    // today's date, from the server's clock
    function techToday() {
      return ymd(request.time);
    }
    // key looks like name_YYYYMMDD_slot, with today's date and a slot from 1 to max
    function daySlot(key, max) {
      let p = key.split('_');
      return p.size() == 4 && p[2] == techToday() && int(p[3]) >= 1 && int(p[3]) <= max;
    }
    // The fixed amount for a key, or -1 when the key is not an award students can earn.
    function amountFor(key) {
      return !(key is string) ? -1
           : key.matches('^sailcar_quiz_(forces|thrust|drag|friction|mass|balance)$') ? 10
           : key == 'sailcar_firstrun' ? 5
           : (key.matches('^sailcar_run_[0-9]{8}_[0-9]$') && daySlot(key, 2)) ? 2
           : key == 'altitude_first' ? 10
           : (key.matches('^altitude_launch_[0-9]{8}_[0-9]$') && daySlot(key, 3)) ? 2
           : key == 'rocket_build' ? 5
           : key.matches('^ruler_race_[A-Za-z0-9]{1,40}$') ? 2
           : -1;
    }
    // The module's quiz is marked passed in the student's own Sail Car progress.
    function sailcarPassed(uid, mod) {
      return exists(/databases/$(database)/documents/sailcar_progress/$(uid))
             && get(/databases/$(database)/documents/sailcar_progress/$(uid)).data.get('modules', {}).get(mod, {}).get('passed', false) == true;
    }
    // The race exists (only the owner makes races), the student played in it, and scored.
    function racePlayed(uid, raceId) {
      return exists(/databases/$(database)/documents/races/$(raceId))
             && exists(/databases/$(database)/documents/races/$(raceId)/players/$(uid))
             && get(/databases/$(database)/documents/races/$(raceId)/players/$(uid)).data.get('score', 0) > 0;
    }
    // The record that proves the award, where one can be found from the key.
    function techProof(uid, key) {
      return (!key.matches('^sailcar_quiz_.*') || sailcarPassed(uid, key.split('_')[2]))
             && (key != 'rocket_build' || exists(/databases/$(database)/documents/rocket_builds/$(uid)))
             && (!key.matches('^ruler_race_.*') || racePlayed(uid, key.split('_')[2]));
    }
    // Fields every ledger document has; classId, by and counted are the only optional ones.
    function techShape(d) {
      return d.keys().hasOnly(['uid', 'key', 'amount', 'kind', 'reason', 'classId', 'createdAt', 'by', 'counted'])
             && d.keys().hasAll(['uid', 'key', 'amount', 'kind', 'reason', 'createdAt'])
             && d.uid is string && d.key is string
             && d.reason is string && d.reason.size() >= 1 && d.reason.size() <= 80
             && d.createdAt == request.time;
    }
    // The student's totals document is written in this same request and names this ledger
    // document as the change it goes with (see the STAGE B note above).
    function coupledTotals(id, uid) {
      let t = getAfter(/databases/$(database)/documents/techbucks_totals/$(uid)).data;
      return t.get('last', '') == id && t.get('updatedAt', null) == request.time;
    }
    // A student's own award. It is either counted now (counted: true, with the totals raised in
    // this batch) or has no mark yet (the shape old pages write; counted later by the migration).
    function validEarn(id) {
      let d = request.resource.data;
      return d.get('kind', '') == 'earn'
             && techShape(d)
             && d.uid == request.auth.uid
             && id == d.uid + '_' + d.key
             && !('by' in d)
             && d.amount == amountFor(d.key)
             && techProof(d.uid, d.key)
             && (!('classId' in d) || (d.classId is string && inClass(d.classId)))
             && (!('counted' in d) || (d.counted == true && coupledTotals(id, d.uid)));
    }
    // A teacher's bonus for a student in one of the teacher's own classes.
    function validBonus(id) {
      let d = request.resource.data;
      return d.get('kind', '') == 'bonus'
             && isTeacher()
             && techShape(d)
             && d.uid.matches('^[A-Za-z0-9]{1,128}$')
             && d.key.matches('^bonus_[A-Za-z0-9]{6,40}$')
             && id == d.uid + '_' + d.key
             && d.amount is int && d.amount >= 1 && d.amount <= 50
             && d.get('by', '') == request.auth.token.email
             && d.get('classId', '') is string && d.get('classId', '') != ''
             && ownsClass(d.get('classId', ''))
             && exists(/databases/$(database)/documents/enrollments/$(d.get('classId', '') + '_' + d.uid))
             && (!('counted' in d) || (d.counted == true && coupledTotals(id, d.uid)));
    }

    // ── Spending (stage B) ──
    // THE price list: every item's price, 0 = free for everyone. Item ids are slot-name
    // (slots: skin, hair, haircolor, face, outfit, hat, gear, pet, back, fx, bg). Keep avatar.js PRICES identical (a test checks).
    // Any other "buy_<itemId>" later (games) is added here and nowhere else.
    // The list is split by slot on purpose: a request may only evaluate 1000 expressions, and an avatar
    // write looks up up to eleven prices. Each slot has its own small table (prices_<slot>); the avatar
    // check below passes the right table straight in, so a lookup builds only the one table it needs and
    // never walks a long if/else chain (that chain was what used up the budget: eleven bought items
    // would not fit). priceFor() (used for purchases) still picks the table by the item's slot.
    function priceFor(item) {
      return item is string ? slotPrices(item.split('-')[0]).get(item, -1) : -1;
    }
    function slotPrices(slot) {
      return slot == 'skin' ? prices_skin()
           : slot == 'hair' ? prices_hair()
           : slot == 'face' ? prices_face()
           : slot == 'hat' ? prices_hat()
           : slot == 'gear' ? prices_gear()
           : slot == 'pet' ? prices_pet()
           : slot == 'back' ? prices_back()
           : slot == 'bg' ? prices_bg()
           : slot == 'outfit' ? prices_outfit()
           : slot == 'haircolor' ? prices_haircolor()
           : slot == 'fx' ? prices_fx()
           : {};
    }
    function prices_skin() {
      return {
              'skin-peach': 0, 'skin-tan': 0, 'skin-brown': 0, 'skin-deep': 0, 'skin-alien': 0, 'skin-robot': 0, 'skin-gold': 60
            };
    }
    function prices_hair() {
      return {
              'hair-short': 0, 'hair-long': 0, 'hair-ponytail': 0, 'hair-pigtails': 0, 'hair-braids': 0, 'hair-bun': 0, 'hair-curly': 0, 'hair-buzz': 0
            };
    }
    function prices_face() {
      return {
              'face-smile': 0, 'face-grin': 5, 'face-wink': 5, 'face-surprised': 8, 'face-starry': 15
            };
    }
    function prices_hat() {
      return {
              'hat-beanie': 8, 'hat-propeller': 12, 'hat-bow': 8, 'hat-flowers': 15, 'hat-tiara': 30, 'hat-hardhat': 15, 'hat-wizard': 25, 'hat-rocket': 30, 'hat-astronaut': 40, 'hat-crown': 60
            };
    }
    function prices_gear() {
      return {
              'gear-earrings': 8, 'gear-glasses': 10, 'gear-sunglasses': 12, 'gear-goggles': 15, 'gear-antenna': 18, 'gear-headphones': 20
            };
    }
    function prices_pet() {
      return {
              'pet-dog': 15, 'pet-spot': 20, 'pet-puppy': 25, 'pet-husky': 30, 'pet-cat': 15, 'pet-blackcat': 20, 'pet-kitten': 25, 'pet-siamese': 30,
              'pet-astrodog': 45, 'pet-astrocat': 45
            };
    }
    function prices_back() {
      return {
              'back-backpack': 15, 'back-cape': 25, 'back-jetpack': 45, 'back-wings': 55
            };
    }
    function prices_bg() {
      return {
              'bg-sky': 0, 'bg-stars': 15, 'bg-hallway': 15, 'bg-lab': 20, 'bg-launchpad': 30, 'bg-moon': 40, 'bg-blackhole': 55
            };
    }
    function prices_outfit() {
      return {
              'outfit-shirt': 0, 'outfit-hoodie': 0, 'outfit-labcoat': 10, 'outfit-overalls': 12, 'outfit-jersey': 15, 'outfit-party': 15,
              'outfit-spacesuit': 25, 'outfit-hero': 30, 'outfit-armor': 45
            };
    }
    function prices_haircolor() {
      return {
              'haircolor-auto': 0, 'haircolor-black': 0, 'haircolor-brown': 0, 'haircolor-blond': 0, 'haircolor-red': 0, 'haircolor-grey': 0,
              'haircolor-blue': 5, 'haircolor-pink': 5, 'haircolor-green': 5, 'haircolor-purple': 5, 'haircolor-silver': 10, 'haircolor-rainbow': 20
            };
    }
    function prices_fx() {
      return {
              'fx-sparkles': 30, 'fx-glow': 40, 'fx-trail': 45, 'fx-lightning': 55, 'fx-fire': 60, 'fx-rainbow': 60, 'fx-orbit': 70
            };
    }
    // A student's purchase: techbucks/{uid}_buy_{itemId}, kind "spend", amount = -price,
    // coupled with the totals going up in "spent" in this same batch (checked on the totals side).
    function validSpend(id) {
      let d = request.resource.data;
      return d.get('kind', '') == 'spend'
             && techShape(d)
             && d.uid == request.auth.uid
             && d.key.matches('^buy_[a-z]+-[a-z]+$')
             && id == d.uid + '_' + d.key
             && spendPriceOk(d, priceFor(d.key.split('_')[1]))
             && !('by' in d) && !('counted' in d)
             && (!('classId' in d) || (d.classId is string && inClass(d.classId)))
             && coupledTotals(id, d.uid);
    }
    function spendPriceOk(d, price) {
      return price > 0 && d.amount == -price;
    }
    // Counting an award that is already there (the migration): only "counted" changes, to true,
    // in the same batch as earned going up by this award's amount.
    function validCounting(id) {
      let o = resource.data;
      return o.get('kind', '') in ['earn', 'bonus']
             && o.uid == request.auth.uid
             && o.get('counted', false) != true
             && request.resource.data.get('counted', false) == true
             && request.resource.data.diff(o).affectedKeys().hasOnly(['counted'])
             && coupledTotals(id, o.uid);
    }
    match /techbucks/{id} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid)
                  || (isTeacher() && ownsClass(resource.data.get('classId', '')));
      allow create: if signedIn() && (validEarn(id) || validBonus(id) || validSpend(id));
      allow update: if signedIn() && validCounting(id);
      // A teacher removes awards (never purchases) of their own classes; a counted one takes
      // its amount out of the student's totals in the same batch.
      allow delete: if isTeacher() && ownsClass(resource.data.get('classId', ''))
                    && resource.data.get('kind', '') in ['earn', 'bonus']
                    && (resource.data.get('counted', false) != true || coupledTotals(id, resource.data.uid));
    }

    // techbucks_totals/{uid}: {uid, earned, spent, last, updatedAt}. Changes only together with the
    // ledger document "last" names (see the STAGE B note above). A student reads their own.
    function totalsCreated(uid, a, b, l) {
      // a ledger document written in this request (its createdAt is this request's time)
      return l.get('createdAt', null) == request.time && l.uid == uid && a.last == uid + '_' + l.key
             && (((l.kind == 'earn' && request.auth.uid == uid) || (l.kind == 'bonus' && isTeacher()))
                  && l.get('counted', false) == true
                  && a.earned == b.earned + l.amount && a.spent == b.spent
                 || (l.kind == 'spend' && request.auth.uid == uid
                     && a.spent == b.spent - l.amount && a.earned == b.earned
                     && a.earned - a.spent >= 0));
    }
    function totalsCounted(uid, a, b, lb, la) {
      // an award that was there before, flipped to counted
      return request.auth.uid == uid && lb.uid == uid && lb.get('kind', '') in ['earn', 'bonus']
             && lb.get('counted', false) != true && la.get('counted', false) == true
             && a.earned == b.earned + lb.amount && a.spent == b.spent;
    }
    function totalsRemoved(uid, a, b, lb) {
      // a counted award removed by a teacher
      return isTeacher() && lb.uid == uid && lb.get('kind', '') in ['earn', 'bonus']
             && lb.get('counted', false) == true
             && a.earned == b.earned - lb.amount && a.spent == b.spent;
    }
    function validTotals(uid) {
      let a = request.resource.data;
      let b = resource == null ? {'earned': 0, 'spent': 0} : resource.data;
      return a.keys().hasOnly(['uid', 'earned', 'spent', 'last', 'updatedAt'])
             && a.keys().hasAll(['uid', 'earned', 'spent', 'updatedAt'])
             && a.uid == uid && a.earned is int && a.spent is int && a.earned >= 0 && a.spent >= 0
             && a.updatedAt == request.time
             && (!('last' in a)
                  ? (resource == null && request.auth.uid == uid && a.earned == 0 && a.spent == 0)
                  : (a.last is string && a.last.size() <= 200
                     && ((existsAfter(/databases/$(database)/documents/techbucks/$(a.last))
                          && !exists(/databases/$(database)/documents/techbucks/$(a.last))
                          && totalsCreated(uid, a, b, getAfter(/databases/$(database)/documents/techbucks/$(a.last)).data))
                         || (existsAfter(/databases/$(database)/documents/techbucks/$(a.last))
                             && exists(/databases/$(database)/documents/techbucks/$(a.last))
                             && totalsCounted(uid, a, b, get(/databases/$(database)/documents/techbucks/$(a.last)).data,
                                              getAfter(/databases/$(database)/documents/techbucks/$(a.last)).data))
                         || (exists(/databases/$(database)/documents/techbucks/$(a.last))
                             && !existsAfter(/databases/$(database)/documents/techbucks/$(a.last))
                             && totalsRemoved(uid, a, b, get(/databases/$(database)/documents/techbucks/$(a.last)).data)))));
    }
    match /techbucks_totals/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && validTotals(uid);
      allow delete: if false;
    }

    // ── Avatars (stage B) ──
    // avatars/{uid} = {uid, equipped: {slot: itemId}, updatedAt}. Any signed-in school account reads;
    // only the student writes their own, with items they may wear.
    // one item in one slot: the right slot, in the catalog, and free or bought. tbl = the price table of
    // that one slot (prices_<slot>, passed in by validAvatar: it must be the table of the slot named).
    function wearable(uid, slot, v, tbl) {
      let p = v is string ? tbl.get(v, -1) : -1;
      return v is string && v.matches('^' + slot + '-[a-z]+$') && p >= 0
             && (p == 0 || existsAfter(/databases/$(database)/documents/techbucks/$(uid + '_buy_' + v)));
    }
    function mayWear(uid, e, slot, tbl) {
      return !(slot in e) || wearable(uid, slot, e[slot], tbl);
    }
    function validAvatar(uid) {
      let d = request.resource.data;
      let e = d.get('equipped', null);
      return d.keys().hasOnly(['uid', 'equipped', 'updatedAt'])
             && d.keys().hasAll(['uid', 'equipped', 'updatedAt'])
             && d.uid == uid && d.updatedAt == request.time
             && e is map
             && e.keys().hasOnly(['skin', 'hair', 'haircolor', 'face', 'outfit', 'hat', 'gear', 'pet', 'back', 'fx', 'bg'])
             && mayWear(uid, e, 'skin', prices_skin()) && mayWear(uid, e, 'hair', prices_hair()) && mayWear(uid, e, 'haircolor', prices_haircolor()) && mayWear(uid, e, 'face', prices_face())
             && mayWear(uid, e, 'outfit', prices_outfit()) && mayWear(uid, e, 'hat', prices_hat()) && mayWear(uid, e, 'gear', prices_gear()) && mayWear(uid, e, 'pet', prices_pet())
             && mayWear(uid, e, 'back', prices_back()) && mayWear(uid, e, 'fx', prices_fx()) && mayWear(uid, e, 'bg', prices_bg());
    }
    match /avatars/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid && validAvatar(uid);
      allow delete: if false;
    }

    // ── Classes, join codes and rosters ─────────────────────────────────────
    // Each class belongs to the teacher in its teacherEmail, and only that
    // teacher (the owner included) can change or delete it.
    // Class names: readable to everyone signed in (other pages list them).
    // classes.html no longer stores the join code here (see joinCodes).
    match /classes/{id} {
      allow read: if signedIn();
      // A class id must be plain letters and digits (the ids the Classes page makes):
      // the pages put it into buttons and links on every student's screen.
      allow create: if isTeacher()
                    && id.matches('^[A-Za-z0-9]{1,40}$')
                    && request.resource.data.teacherEmail == request.auth.token.email;
      allow update: if isTeacher()
                    && resource.data.teacherEmail == request.auth.token.email
                    && request.resource.data.teacherEmail == resource.data.teacherEmail;
      allow delete: if isTeacher()
                    && resource.data.teacherEmail == request.auth.token.email;
    }
    // One doc per join code; the doc id IS the code:
    // {classId, className, teacherEmail, createdAt}. Anyone signed in may look
    // up the one code they typed. A teacher may list only the codes of their own
    // classes (the Classes page asks for "teacherEmail == me" or "classId == one
    // of mine"), so nobody can collect another teacher's codes, and may write
    // only a code of their own that points at one of their own classes.
    // A code is often written in the same batch as its class, so create and
    // update look at the class as it will be (getAfter). A code is deleted
    // together with its class, so delete goes by the code's own teacherEmail.
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if isTeacher()
                  && (resource.data.teacherEmail == request.auth.token.email
                      || ownsClass(resource.data.classId));
      allow create: if isTeacher()
                    && request.resource.data.teacherEmail == request.auth.token.email
                    && ownsClassAfter(request.resource.data.classId);
      allow update: if isTeacher()
                    && resource.data.teacherEmail == request.auth.token.email
                    && request.resource.data.teacherEmail == request.auth.token.email
                    && ownsClassAfter(request.resource.data.classId);
      allow delete: if isTeacher()
                    && resource.data.teacherEmail == request.auth.token.email;
    }
    // A student's own entry: the student can read, join (validJoin) and leave.
    // A teacher can read and change the entries of their own classes only.
    // (One batch may delete a class and its whole roster: the class is still
    // seen as it was before the batch.)
    match /enrollments/{id} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid)
                  || (isTeacher() && ownsClass(resource.data.classId));
      allow create: if (signedIn() && validJoin(id))
                    || teacherRosterWrite(id);
      allow update: if (signedIn() && validJoin(id) && resource.data.uid == request.auth.uid)
                    || (teacherRosterWrite(id) && ownsClass(resource.data.classId));
      allow delete: if (signedIn() && resource.data.uid == request.auth.uid)
                    || (isTeacher() && ownsClass(resource.data.classId));
    }

    // ── Ruler game Race Mode (unchanged) ────────────────────────────────────
    match /races/{raceId} {
      allow read: if signedIn();
      allow write: if isOwner();
      match /players/{uid} {
        allow read: if signedIn();
        allow write: if isOwner() || (signedIn() && request.auth.uid == uid);
      }
    }
  }
}
